#!/usr/bin/env bash
# Credential discovery (as the engine, from KEYCARD_* variables) and client registration
# against a live zone. Registration adds a public client to the zone.
source "$(dirname "$0")/env.sh"
export ENGINE_SECRET_FILE="${ENGINE_SECRET_FILE:-$LIVE_DIR/engine-secret.json}"
mint_svid spiffe://java-sdk.test/engine "$SVID_FILE"
exec "$ROOT/gradlew" -q -p "$ROOT/examples/engine-obo" onboardingE2e
