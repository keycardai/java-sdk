#!/usr/bin/env bash
# Mints a fresh JWT-SVID from the SPIRE server container, then runs both scenarios.
source "$(dirname "$0")/env.sh"
mint_svid spiffe://java-sdk.test/engine "$SVID_FILE"
[ -n "${GATEWAY_SVID_FILE:-}" ] && mint_svid spiffe://java-sdk.test/gateway "$GATEWAY_SVID_FILE"
exec "$ROOT/gradlew" -q -p "$ROOT/examples/engine-obo" liveE2e
